# Copy to .env and fill in. Never commit the real file.

# Required. Long random string. Signs every media ticket. Changing it invalidates open links.
TRAWLER_SECRET=

# Public origin, used for CORS on the API.
TRAWLER_PUBLIC_ORIGIN=https://trawler.espectator.net

# Optional. Path to a Netscape cookies.txt for sites that require a session.
TRAWLER_COOKIES_FILE=

# MCP bearer token. Leave empty to disable the /api/mcp mount entirely.
TRAWLER_MCP_TOKEN=
